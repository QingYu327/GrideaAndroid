{# 404 错误页，对应 TemplateEngine.render404 #}
{# 输出路径：404.html（根目录），baseUrl="./" #}
{# 不传 themePackConfig #}
{# 内联样式使用 CSS 变量 var(--primary)/var(--text)/var(--radius)，原样保留 #}
{% extends "base" %}

{% block content %}
<div class="error-page" style="text-align:center;padding:80px 20px;">
    <h1 class="error-code" style="font-size:120px;font-weight:bold;color:var(--primary);line-height:1;margin:0 0 16px;">404</h1>
    <p class="error-message" style="font-size:24px;color:var(--text);margin:0 0 12px;">页面不存在</p>
    <p class="error-desc" style="font-size:14px;color:rgba(0,0,0,0.5);margin:0 0 32px;">抱歉，您访问的页面不存在或已被移除。</p>
    <a href="./" class="error-back-home" style="display:inline-block;padding:10px 28px;border-radius:var(--radius);background:var(--primary);color:#fff;font-size:15px;">返回首页</a>
</div>
{% endblock %}
