{# 标签详情页，对应 TemplateEngine.renderTagDetail #}
{# 输出路径：{tagPath}/{slug}/index.html，baseUrl="../../" #}
{# 传 themePackConfig（与 tags 汇总页不同） #}
{# post-card 结构与 index.peb 一致 #}
{% extends "base" %}

{% block content %}
<div class="tag-detail">
    <h1 class="page-title">标签: {{ tag.name }}</h1>
    <div class="post-list">
        {% if posts is not empty %}
        {% for post in posts %}
        <article class="post-card">
            {% if post.feature %}
            <div class="post-card-feature">
                <a href="{{ post.link }}"><img src="{{ post.feature }}" alt="{{ post.title }}" loading="lazy" decoding="async" width="800" height="440"></a>
            </div>
            {% endif %}
            <div class="post-card-body">
                <h2 class="post-card-title">
                    <a href="{{ post.link }}">{{ post.title }}</a>
                </h2>
                <div class="post-card-meta">
                    <span class="post-date">{{ post.date }}</span>
                </div>
                <div class="post-card-abstract">{{ post.abstract | raw }}</div>
                <div class="post-card-footer">
                    <div class="post-card-tags">
                        {% for tag in post.tags %}
                        <a href="{{ tag.link }}" class="tag-chip">{{ tag.name }}</a>
                        {% endfor %}
                    </div>
                    <a href="{{ post.link }}" class="read-more">阅读全文</a>
                </div>
            </div>
        </article>
        {% endfor %}
        {% else %}
        <div class="empty">该标签下暂无文章</div>
        {% endif %}
    </div>
    {% if pagination.total > 1 %}
    <nav class="pagination">
        {% if pagination.prev %}
        <a href="{{ pagination.prev }}" class="page-prev">上一页</a>
        {% endif %}
        <span class="page-info">{{ pagination.current }} / {{ pagination.total }}</span>
        {% if pagination.next %}
        <a href="{{ pagination.next }}" class="page-next">下一页</a>
        {% endif %}
    </nav>
    {% endif %}
</div>
{% endblock %}
