{# 03-Magazine 首页 — 杂志网格布局 #}
{% extends "base" %}

{% block content %}
{% if showHero or themePackConfig.show_hero == "true" %}
<section class="hero">
    <h1 class="hero-title">{{ site.siteName }}</h1>
    <p class="hero-desc">{{ site.siteDescription }}</p>
</section>
{% endif %}
{% if posts is not empty %}
<div class="magazine-layout">
    <div class="magazine-main">
    {# 第一篇文章作为特色文章 #}
    {% set firstPost = posts[0] %}
    <article class="featured-post">
        {% if firstPost.feature %}
        <a href="{{ firstPost.link }}" class="featured-cover">
            <img src="{{ firstPost.feature }}" alt="{{ firstPost.title }}" loading="lazy">
        </a>
        {% endif %}
        <div class="featured-body">
            <div class="featured-meta">
                <span class="featured-date">{{ firstPost.date }}</span>
                {% for tag in firstPost.tags %}
                <a href="{{ tag.link }}" class="tag-chip">{{ tag.name }}</a>
                {% endfor %}
            </div>
            <h2 class="featured-title">
                <a href="{{ firstPost.link }}">{{ firstPost.title }}</a>
            </h2>
            <div class="featured-abstract">{{ firstPost.abstract | raw }}</div>
            <a href="{{ firstPost.link }}" class="read-more">阅读全文 →</a>
        </div>
    </article>

    {# 其余文章为网格 #}
    {% set restPosts = posts|slice(1, posts|length) %}
    {% if restPosts is not empty %}
    <div class="post-grid">
        {% for post in restPosts %}
        <article class="post-card">
            {% if post.feature %}
            <a href="{{ post.link }}" class="post-card-cover">
                <img src="{{ post.feature }}" alt="{{ post.title }}" loading="lazy">
            </a>
            {% endif %}
            <div class="post-card-body">
                <div class="post-card-meta">
                    <span class="post-date">{{ post.date }}</span>
                    {% for tag in post.tags %}
                    <a href="{{ tag.link }}" class="tag-chip">{{ tag.name }}</a>
                    {% endfor %}
                </div>
                <h3 class="post-card-title">
                    <a href="{{ post.link }}">{{ post.title }}</a>
                </h3>
                <div class="post-card-abstract">{{ post.abstract | raw }}</div>
            </div>
        </article>
        {% endfor %}
    </div>
    {% endif %}
    </div>

    <aside class="magazine-sidebar">
        {# 热门标签 Widget #}
        {% if tags is not empty %}
        <div class="widget widget-tags">
            <h3 class="widget-title">热门标签</h3>
            <div class="widget-tag-cloud">
                {% for tag in tags %}
                <a href="{{ tag.link }}" class="widget-tag-chip">
                    {{ tag.name }}{% if tag.count %}<span class="widget-tag-count">{{ tag.count }}</span>{% endif %}
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {# 关于 Widget #}
        {% if site.siteDescription %}
        <div class="widget widget-about">
            <h3 class="widget-title">关于</h3>
            <p>{{ site.siteDescription }}</p>
        </div>
        {% endif %}
    </aside>
</div>
{% else %}
<div class="empty">暂无文章</div>
{% endif %}

{% if pagination.total > 1 %}
<nav class="pagination">
    {% if pagination.prev %}
    <a href="{{ pagination.prev }}" class="page-prev">← 上一页</a>
    {% endif %}
    <span class="page-info">{{ pagination.current }} / {{ pagination.total }}</span>
    {% if pagination.next %}
    <a href="{{ pagination.next }}" class="page-next">下一页 →</a>
    {% endif %}
</nav>
{% endif %}
{% endblock %}
