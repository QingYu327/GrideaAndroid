{# 08-Terminal 归档页 #}
{% extends "base" %}

{% block content %}
<div class="archives-page">
    <p class="page-path"><span class="prompt-dollar">$</span> ls -R ./archives/</p>
    <h1 class="page-title"><span class="title-prefix">&gt;</span> 归档</h1>
    {% if archivesByYear is not empty %}
    {% for year in archivesByYear %}
    <div class="archive-year">
        <h2 class="archive-year-title"><span class="prompt-dollar">$</span> {{ year.year }}/</h2>
        <ul class="archive-list">
            {% for post in year.posts %}
            <li class="archive-item">
                <span class="archive-date"><span class="comment">#</span> {{ post.date }}</span>
                <a href="{{ post.link }}" class="archive-title">{{ post.title }}</a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty"><span class="prompt-dollar">$</span> echo "暂无文章"<span class="cursor-blink">_</span></div>
    {% endif %}
</div>
{% endblock %}
