{# 08-Terminal 首页 #}
{% extends "base" %}

{% block content %}
{% if showHero or themePackConfig.show_hero == "true" %}
<section class="hero">
    <p class="hero-line"><span class="prompt-dollar">$</span> cat about.txt</p>
    <h1 class="hero-title">{{ site.siteName }}</h1>
    <p class="hero-desc">{{ site.siteDescription }}</p>
</section>
{% endif %}
<div class="post-list">
    <p class="list-header"><span class="prompt-dollar">$</span> ls -la ./posts<span class="cursor-blink">_</span></p>
    {% if posts is not empty %}
    {% for post in posts %}
    <article class="post-card">
        <div class="post-card-body">
            <h2 class="post-card-title">
                <span class="title-prefix">&gt;</span> <a href="{{ post.link }}">{{ post.title }}</a>
            </h2>
            <div class="post-card-meta">
                <span class="post-date"><span class="comment">#</span> {{ post.date }}</span>
                {% for tag in post.tags %}
                <a href="{{ tag.link }}" class="tag-chip"><span class="bracket">[</span>{{ tag.name }}<span class="bracket">]</span></a>
                {% endfor %}
            </div>
            <div class="post-card-abstract">{{ post.abstract | raw }}</div>
            <a href="{{ post.link }}" class="read-more"><span class="prompt-dollar">$</span> cat {{ post.fileName }}.md →</a>
        </div>
    </article>
    {% endfor %}
    {% else %}
    <div class="empty"><span class="prompt-dollar">$</span> echo "暂无文章"<span class="cursor-blink">_</span></div>
    {% endif %}
</div>
{% if pagination.total > 1 %}
<nav class="pagination">
    {% if pagination.prev %}
    <a href="{{ pagination.prev }}" class="page-prev"><span class="prompt-dollar">$</span> prev</a>
    {% endif %}
    <span class="page-info">[ {{ pagination.current }} / {{ pagination.total }} ]</span>
    {% if pagination.next %}
    <a href="{{ pagination.next }}" class="page-next">next <span class="prompt-dollar">$</span></a>
    {% endif %}
</nav>
{% endif %}
{% endblock %}
