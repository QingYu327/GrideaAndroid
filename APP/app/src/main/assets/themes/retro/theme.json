{
  "id": "retro",
  "name": "复古打字机",
  "version": "1.0.0",
  "author": "Gridea",
  "description": "米色纸张背景与打字机字体，营造旧报纸信件般的复古阅读体验",
  "previewImage": null,
  "tags": ["复古", "打字机", "米色"],
  "isBuiltin": false,
  "customConfig": [
    {
      "name": "accent_color",
      "label": "强调色",
      "group": "颜色",
      "type": "color",
      "value": "#8b4513",
      "note": "用于链接、标签、按钮等交互元素"
    },
    {
      "name": "show_hero",
      "label": "首页大标题",
      "group": "排版",
      "type": "switch",
      "value": true,
      "note": "在首页顶部显示站点名称和描述"
    },
    {
      "name": "content_width",
      "label": "内容宽度",
      "group": "排版",
      "type": "slider",
      "value": 720,
      "min": 600,
      "max": 1000,
      "step": 20,
      "note": "文章内容的最大宽度（像素）"
    },
    {
      "name": "cursor_blink",
      "label": "标题光标闪烁",
      "group": "排版",
      "type": "switch",
      "value": true,
      "note": "标题末尾显示打字机光标闪烁动画"
    },
    {
      "name": "ga",
      "label": "Google Analytics",
      "group": "统计",
      "type": "input",
      "value": "",
      "placeholder": "G-XXXXXXXXXX"
    },
    {
      "name": "baidu",
      "label": "百度统计 Token",
      "group": "统计",
      "type": "input",
      "value": "",
      "placeholder": "百度统计的 hm.js token"
    },
    {
      "name": "tencent",
      "label": "腾讯分析 ID",
      "group": "统计",
      "type": "input",
      "value": "",
      "placeholder": "腾讯分析的项目 ID"
    },
    {
      "name": "view",
      "label": "不蒜子访客",
      "group": "统计",
      "type": "switch",
      "value": false,
      "note": "启用不蒜子访客统计"
    }
  ]
}
